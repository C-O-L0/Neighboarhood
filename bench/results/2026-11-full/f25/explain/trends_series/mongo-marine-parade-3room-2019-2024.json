                      "input": "$prices",
                      "sortBy": 1
                    }
                  },
                  {
                    "$floor": {
                      "$divide": [
                        {
                          "$subtract": [
                            "$n",
                            1
                          ]
                        },
                        2
                      ]
                    }
                  }
                ]
              },
              "avg_psm": {
                "$round": [
                  {
                    "$divide": [
                      "$sum_psm",
                      "$n"
                    ]
                  },
                  2
                ]
              },
              "prev_year_median": {
                "$cond": [
                  {
                    "$gt": [
                      "$prev_n",
                      0
                    ]
                  },
                  {
                    "$arrayElemAt": [
                      {
                        "$sortArray": {
                          "input": {
                            "$reduce": {
                              "input": "$prev_prices",
                              "initialValue": [],
                              "in": {
                                "$concatArrays": [
                                  "$$value",
                                  "$$this"
                                ]
                              }
                            }
                          },
                          "sortBy": 1
                        }
                      },
                      {
                        "$floor": {
                          "$divide": [
                            {
                              "$subtract": [
                                "$prev_n",
                                1
                              ]
                            },
                            2
                          ]
                        }
                      }
                    ]
                  },
                  null
                ]
              },
              "rolling_n": "$roll_n",
              "rolling_median": {
                "$arrayElemAt": [
                  {
                    "$sortArray": {
                      "input": {
                        "$reduce": {
                          "input": "$roll_prices",
                          "initialValue": [],
                          "in": {
                            "$concatArrays": [
                              "$$value",
                              "$$this"
                            ]
                          }
                        }
                      },
                      "sortBy": 1
                    }
                  },
                  {
                    "$floor": {
                      "$divide": [
                        {
                          "$subtract": [
                            "$roll_n",
                            1
                          ]
                        },
                        2
                      ]
                    }
                  }
                ]
              }
            }
          },
          {
            "$sort": {
              "month": 1
            }
          }
        ],
        "cursor": {},
        "$db": "neighboar"
      }
    }
  }
]