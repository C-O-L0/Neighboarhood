{
  "$jsonSchema": {
    "bsonType": "object",
    "title": "building_profiles: one document per HDB block",
    "additionalProperties": false,
    "required": [
      "_id",
      "block",
      "street",
      "town",
      "in_property_dataset",
      "stats",
      "recent_sales"
    ],
    "anyOf": [
      {
        "description": "in the property dataset: supply is present (an empty array means no units)",
        "properties": {
          "in_property_dataset": {
            "enum": [
              true
            ]
          },
          "year_completed": {
            "bsonType": "int"
          },
          "max_floor": {
            "bsonType": "int"
          },
          "residential": {
            "bsonType": "bool"
          },
          "commercial": {
            "bsonType": "bool"
          },
          "market_hawker": {
            "bsonType": "bool"
          },
          "miscellaneous": {
            "bsonType": "bool"
          },
          "multistorey_carpark": {
            "bsonType": "bool"
          },
          "precinct_pavilion": {
            "bsonType": "bool"
          }
        },
        "required": [
          "supply",
          "year_completed",
          "max_floor",
          "residential",
          "commercial",
          "market_hawker",
          "miscellaneous",
          "multistorey_carpark",
          "precinct_pavilion"
        ]
      },
      {
        "description": "stub: no property data, so supply is absent (unknown, not zero) and property attributes are null",
        "properties": {
          "in_property_dataset": {
            "enum": [
              false
            ]
          },
          "year_completed": {
            "bsonType": "null"
          },
          "max_floor": {
            "bsonType": "null"
          },
          "residential": {
            "bsonType": "null"
          },
          "commercial": {
            "bsonType": "null"
          },
          "market_hawker": {
            "bsonType": "null"
          },
          "miscellaneous": {
            "bsonType": "null"
          },
          "multistorey_carpark": {
            "bsonType": "null"
          },
          "precinct_pavilion": {
            "bsonType": "null"
          }
        },
        "not": {
          "required": [
            "supply"
          ]
        }
      }
    ],
    "properties": {
      "_id": {
        "bsonType": [
          "int",
          "long"
        ]
      },
      "block": {
        "bsonType": "string",
        "maxLength": 5
      },
      "street": {
        "bsonType": "string",
        "maxLength": 40
      },
      "town": {
        "bsonType": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "name"
        ],
        "properties": {
          "code": {
            "bsonType": "string",
            "maxLength": 3
          },
          "name": {
            "bsonType": "string",
            "maxLength": 40
          }
        }
      },
      "year_completed": {
        "bsonType": [
          "int",
          "null"
        ],
        "minimum": 1900,
        "maximum": 2100
      },
      "lease_commence_year": {
        "bsonType": [
          "int",
          "null"
        ],
        "minimum": 1900,
        "maximum": 2100
      },
      "max_floor": {
        "bsonType": [
          "int",
          "null"
        ],
        "minimum": 1,
        "maximum": 60
      },
      "residential": {
        "bsonType": [
          "bool",
          "null"
        ]
      },
      "commercial": {
        "bsonType": [
          "bool",
          "null"
        ]
      },
      "market_hawker": {
        "bsonType": [
          "bool",
          "null"
        ]
      },
      "miscellaneous": {
        "bsonType": [
          "bool",
          "null"
        ]
      },
      "multistorey_carpark": {
        "bsonType": [
          "bool",
          "null"
        ]
      },
      "precinct_pavilion": {
        "bsonType": [
          "bool",
          "null"
        ]
      },
      "in_property_dataset": {
        "bsonType": "bool"
      },
      "location": {
        "bsonType": "object",
        "required": [
          "type",
          "coordinates"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "Point"
            ]
          },
          "coordinates": {
            "bsonType": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "bsonType": "double"
            }
          }
        }
      },
      "supply": {
        "bsonType": "array",
        "items": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "flat_type",
            "sold",
            "rental"
          ],
          "properties": {
            "flat_type": {
              "bsonType": "string",
              "maxLength": 20
            },
            "sold": {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 0
            },
            "rental": {
              "bsonType": [
                "int",
                "long"
              ],
              "minimum": 0
            }
          }
        }
      },
      "stats": {
        "bsonType": "object",
        "additionalProperties": false,
        "required": [
          "txn_count",
          "median_price",
          "avg_psm",
          "by_flat_type",
          "last_txn_month"
        ],
        "properties": {
          "txn_count": {
            "bsonType": [
              "int",
              "long"
            ],
            "minimum": 0
          },
          "median_price": {
            "bsonType": [
              "decimal",
              "null"
            ]
          },
          "avg_psm": {
            "bsonType": [
              "decimal",
              "null"
            ]
          },
          "by_flat_type": {
            "bsonType": "array",
            "items": {
              "bsonType": "object",
              "additionalProperties": false,
              "required": [
                "flat_type",
                "txn_count",
                "median_price",
                "avg_psm"
              ],
              "properties": {
                "flat_type": {
                  "bsonType": "string",
                  "maxLength": 20
                },
                "txn_count": {
                  "bsonType": [
                    "int",
                    "long"
                  ],
                  "minimum": 1
                },
                "median_price": {
                  "bsonType": "decimal"
                },
                "avg_psm": {
                  "bsonType": "decimal"
                }
              }
            }
          },
          "last_txn_month": {
            "bsonType": [
              "date",
              "null"
            ]
          }
        }
      },
      "recent_sales": {
        "bsonType": "array",
        "maxItems": 10,
        "items": {
          "bsonType": "object",
          "additionalProperties": false,
          "required": [
            "txn_id",
            "txn_month",
            "flat_type",
            "flat_model",
            "storey_min",
            "storey_max",
            "floor_area_sqm",
            "resale_price"
          ],
          "properties": {
            "txn_id": {
              "bsonType": [
                "int",
                "long"
              ]
            },
            "txn_month": {
              "bsonType": "date"
            },
            "flat_type": {
              "bsonType": "string",
              "maxLength": 20
            },
            "flat_model": {
              "bsonType": "string",
              "maxLength": 30
            },
            "storey_min": {
              "bsonType": "int",
              "minimum": 1,
              "maximum": 60
            },
            "storey_max": {
              "bsonType": "int",
              "minimum": 1,
              "maximum": 60
            },
            "floor_area_sqm": {
              "bsonType": "decimal"
            },
            "resale_price": {
              "bsonType": "decimal"
            }
          }
        }
      }
    }
  },
  "$expr": {
    "$cond": [
      {
        "$eq": [
          {
            "$type": "$location"
          },
          "missing"
        ]
      },
      true,
      {
        "$and": [
          {
            "$gte": [
              {
                "$arrayElemAt": [
                  "$location.coordinates",
                  0
                ]
              },
              103.59
            ]
          },
          {
            "$lte": [
              {
                "$arrayElemAt": [
                  "$location.coordinates",
                  0
                ]
              },
              104.1
            ]
          },
          {
            "$gte": [
              {
                "$arrayElemAt": [
                  "$location.coordinates",
                  1
                ]
              },
              1.15
            ]
          },
          {
            "$lte": [
              {
                "$arrayElemAt": [
                  "$location.coordinates",
                  1
                ]
              },
              1.48
            ]
          }
        ]
      }
    ]
  }
}
