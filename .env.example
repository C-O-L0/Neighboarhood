# Copy to .env and replace every "change-me" value before the first start.
# .env is git-ignored; never commit real passwords.

# ---- PostgreSQL ----
# Superuser: used only by the migrate step to create roles.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-pg-super
POSTGRES_DB=neighboar
# Owner of every schema object (migrations and ETL).
PG_OWNER_PASSWORD=change-me-pg-owner
# Application roles (least privilege).
PG_APP_RW_PASSWORD=change-me-pg-app-rw
PG_APP_ADMIN_PASSWORD=change-me-pg-app-admin
PG_APP_RO_PASSWORD=change-me-pg-app-ro

# ---- MongoDB ----
# Root: used only by the migrate step to initiate the replica set and create users.
MONGODB_INITDB_ROOT_USERNAME=root
MONGODB_INITDB_ROOT_PASSWORD=change-me-mongo-root
MONGO_DB=neighboar
MONGO_ETL_PASSWORD=change-me-mongo-etl
MONGO_APP_PASSWORD=change-me-mongo-app
MONGO_APP_ADMIN_PASSWORD=change-me-mongo-app-admin

# ---- Cache sizes (keep the two equal for fair benchmarks) ----
PG_SHARED_BUFFERS=512MB
MONGO_CACHE_GB=0.5

# ---- Web app ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-long-random-string

# ---- Demo accounts (loaded by the ETL, ids 1 and 2) ----
# Emails: demo@neighboar.local and admin@neighboar.local. Choose your own passwords,
# 10 to 128 characters, not starting with "change-me". Used by the etl service and the tests only.
DEMO_BUYER_PASSWORD=change-me-demo-buyer
DEMO_ADMIN_PASSWORD=change-me-demo-admin
